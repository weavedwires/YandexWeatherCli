#!/usr/bin/env sh
# Wrapper for YandexWeatherCli. Runs the uber-jar placed next to this script.
set -e

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

JAR=""
for candidate in "$DIR/yweather.jar" "$DIR"/yweather-*.jar; do
  if [ -f "$candidate" ]; then
    JAR="$candidate"
    break
  fi
done

if [ -z "$JAR" ]; then
  echo "yweather: yweather.jar не найден рядом с $DIR" >&2
  exit 1
fi

exec java -jar "$JAR" "$@"
